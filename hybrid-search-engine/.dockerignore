data
models

# Benchmark results (large, not needed in image)
Benchmark/results

# SQLite and FAISS files (mounted at runtime)
*.sqlite
*.faiss
*.npy

# Development / editor files
*.env
.env.*
*.log
.DS_Store
Thumbs.db

# Jupyter
*.ipynb
.ipynb_checkpoints
